# Cosm500 1-rank Zeldovich-MPI control (500^3, CPD=243)
#
# MPI: mpiexec -n 1 with NumZRanks=1 => grid 1 x 1 (no Alltoallv exchange).
# N is taken from NP below; do not pass N on the command line.
#
# Paths below are placeholders; run.sh writes .runtime/param.par2 with absolute
# paths from IC_OUTPUT_DIR, PK_FILE, and PLT_FILE (see env.sh / README).

BoxSize = 325.
NP = 16777216 #N=256
CPD = 243
InitialConditionsDirectory = "./output"
InitialRedshift = 49.
ICFormat = "RVZel"
ZD_NumBlock = 4
ZD_Pk_filename = "./data/class_pk_z1.dat"
ZD_Pk_primordial_filename = "./data/class_pk_primordial_dimensional.dat"
ZD_PNG_DIR = "./png_slices"
ZD_Seed = 12345.
ZD_qPLT = 1
ZD_PLT_filename = "./data/eigmodes128"
ZD_qPLT_rescale = 1
ZD_PLT_target_z = 5
ZD_k_cutoff = 1.
ZD_Pk_scale = 1.0
ZD_Pk_norm = 8.0
ZD_Pk_smooth = 0.0
ZD_Version = 2
ZD_f_cluster = 1.0
# ZD_Pk_sigma = 0.02086274818611812
ZD_Pk_sigma_ratio = 0.04184690925780686   # D(z=49)/D(z=1) from Abacus calc_growth_ratio (abacus-public df6a23a; Omega_M above, flat LCDM, Omega_smooth=0.0)
ZD_Pk_file_redshift = 1.0   # redshift of ZD_Pk_filename; used by abacus.param to compute ZD_Pk_sigma_ratio
ZD_qPk_fix_to_mean = 0
ZD_f_NL = 100
Omega_M = 0.3141531891588591
ZD_n_s = 0.9652
ZD_qdensity = 1

NumZRanks = 1

# Toggle which f_NL to compute
# Every nonzero shape is computed in one run: Kernel_MPI writes kernel_<shape>_y.{y}, and
# Zeldovich_MPI (LOAD_D_FROM_FILE) writes phi_<shape>_fNL<ZD_f_NL>_divided_y.{y}, all with amplitude ZD_f_NL
# Zeldovich_MPI (LOAD_WHITE_NOISE_FROM_FILE) loads phi_<shape>_fNL<ZD_f_NL>_divided_y.{y} from ZD_PNG_DIR,
# so exactly one shape may be nonzero. To load {name}_y.{y} instead, set all shapes to 0 and set:

ZD_f_NL_local = 1
ZD_f_NL_equil = 0
ZD_f_NL_orthoCMB = 0
ZD_f_NL_orthoLSS = 0
#ZD_white_noise_name = "my_phi"
